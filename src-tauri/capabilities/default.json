{
  "$schema": "https://schema.tauri.app/config/2/capability.json",
  "identifier": "default",
  "description": "Default app capabilities",
  "platforms": [
    "linux",
    "macOS",
    "windows",
    "android"
  ],
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",
    "shell:allow-open",
    "shell:default",
    "opener:default",
    "notification:default",
    "store:allow-get",
    "store:allow-set",
    "store:allow-delete",
    "store:allow-load",
    "store:allow-save",
    "store:allow-clear",
    "store:allow-has",
    "deep-link:default",
    "updater:default",
    "process:allow-restart",
    "fs:allow-open",
    "fs:allow-write",
    "fs:allow-remove",
    "fs:allow-exists",
    "fs:allow-mkdir",
    "fs:allow-appcache-read-recursive",
    "fs:allow-appcache-write-recursive"
  ]
}
