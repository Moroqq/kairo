# Переменные окружения бэкенда Kairo.
#
# Файл появился после того, как ИИ-функции легли целиком, а причину пришлось
# искать через /proc/<pid>/environ: нигде в репозитории не было сказано, какие
# переменные вообще существуют и что в них лежит. Держим список здесь.
#
# Сервер сам .env не читает — переменные передаёт systemd (EnvironmentFile=)
# или менеджер процессов. Для локального запуска: node --env-file=.env dist/index.js

# ── Сеть ─────────────────────────────────────────────────────────────────
PORT=8787
HOST=0.0.0.0

# ── Groq: разбор текста в задачу и распознавание речи ────────────────────
GROQ_API_KEY=
# Пусто = напрямую в https://api.groq.com. Заполнено = адрес прокси перед ним.
GROQ_BASE_URL=

# Имена моделей — расходник: провайдер снимает их с раздачи без предупреждения,
# и тогда всё, что через них ходит, отвечает 404 model_not_found.
# Живой список: curl -H "authorization: Bearer $GROQ_API_KEY" "$GROQ_BASE_URL/openai/v1/models"
GROQ_TEXT_MODEL=openai/gpt-oss-120b
GROQ_STT_MODEL=whisper-large-v3-turbo

# ── OpenRouter: разбор картинок (у Groq нет vision) ──────────────────────
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=
# Общий секрет, если между сервером и провайдером стоит свой прокси.
OPENROUTER_PROXY_SECRET=

# Список через запятую, пробуется по порядку. Именно список, а не одно имя:
# бесплатные vision-модели делят общий пул провайдера и регулярно отдают 429,
# так что нужен переход к следующей, а не отказ.
OPENROUTER_IMAGE_MODELS=minimax/minimax-m3:free,dots-studio/dots-3-note-preview:free,google/gemma-4-31b-it:free

# ── Обновления приложения ────────────────────────────────────────────────
# Каталог с latest.json и файлами сборок. По умолчанию server/data/update.
KAIRO_UPDATE_DIR=
