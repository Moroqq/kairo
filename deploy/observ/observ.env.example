# → /etc/observ.env   (chown root:observ, chmod 640)
#
# Токен бота @BotFather. Без него /api/lead вернёт 500, а заявки с сайта
# не дойдут.
TELEGRAM_BOT_TOKEN=

# ID чата/канала, куда падают лиды.
TELEGRAM_CHAT_ID=

# Секрет вебхука Telegram. Тот же самый передаётся в setWebhook
# (параметр secret_token) — /api/telegram/webhook отклоняет всё,
# у чего заголовок X-Telegram-Bot-Api-Secret-Token не совпал.
# Сгенерировать: openssl rand -hex 32
TELEGRAM_WEBHOOK_SECRET=

# Необязательно: прокси до api.telegram.org, если с VPS он недоступен.
# Понимаются оба имени, socks5:// и http(s)://.
#PROXY_URL=socks5://user:pass@host:1080
#SOCKS_PROXY=socks5://user:pass@host:1080
