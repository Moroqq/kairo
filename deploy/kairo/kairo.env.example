# → /etc/kairo.env   (chown root:kairo, chmod 640)
#
# Без ключей бэкенд поднимется и синк будет работать — откажут только
# ИИ-функции: разбор текста, распознавание голоса, картинки.

# Groq: разбор текста и Whisper для голосового ввода.
GROQ_API_KEY=
#GROQ_BASE_URL=https://api.groq.com
#GROQ_TEXT_MODEL=
#GROQ_STT_MODEL=

# OpenRouter: генерация картинок.
OPENROUTER_API_KEY=
#OPENROUTER_BASE_URL=https://openrouter.ai/api
#OPENROUTER_IMAGE_MODEL=
#OPENROUTER_IMAGE_MODELS=

# Общий секрет для прокси-маршрута OpenRouter. Сгенерировать:
#   openssl rand -hex 32
OPENROUTER_PROXY_SECRET=

# Пути. Менять не нужно — значения совпадают с тем, что ждёт юнит.
KAIRO_DB_PATH=/opt/kairo-server/server/data/kairo.db
KAIRO_UPDATE_DIR=/opt/kairo-server/server/updates

# Таймауты ИИ-запросов в миллисекундах (по умолчанию разумные).
#AI_CHAT_TIMEOUT_MS=
#AI_STT_TIMEOUT_MS=
#AI_IMAGE_TIMEOUT_MS=
