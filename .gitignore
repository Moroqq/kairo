# dependencies
node_modules

# build outputs
dist
dist-ssr

# Tauri
src-tauri/target
# Updater signing keys — приватный ключ НИКОГДА не должен попасть в git.
# Публичный (updater.key.pub) не секрет, но нам всё равно достаточно
# хранить его в tauri.conf.json — файл на диске не нужен.
src-tauri/updater.key
src-tauri/updater.key.pub

# Kairo server (VPS backend)
server/dist
server/data/*.db
server/data/*.db-*
# Файлы релиза, которые раздаёт GET /update/... — кладутся на сервер вручную,
# в репозитории им делать нечего (шаблон манифеста: server/update.example.json).
server/data/update/

# env
.env
.env.local
.env.*.local

